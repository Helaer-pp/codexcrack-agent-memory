cmake_minimum_required(VERSION 3.20)
project(CrackV4Integration LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(OPENCV440_SDK "D:/opencv-4.4.0/build" CACHE PATH "OpenCV 4.4.0 SDK root (contains include and x64)")
add_executable(CrackV4Example example/main.cpp)
target_include_directories(CrackV4Example PRIVATE include "${OPENCV440_SDK}/include")
target_link_libraries(CrackV4Example PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/lib/CrackV4.lib" "${OPENCV440_SDK}/x64/vc15/lib/opencv_world440.lib")
target_compile_options(CrackV4Example PRIVATE /utf-8)
foreach(runtime CrackV4.dll opencv_world440.dll)
  add_custom_command(TARGET CrackV4Example POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_CURRENT_SOURCE_DIR}/bin/${runtime}" "$<TARGET_FILE_DIR:CrackV4Example>")
endforeach()
