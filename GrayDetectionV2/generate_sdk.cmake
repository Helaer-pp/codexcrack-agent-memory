cmake_minimum_required(VERSION 3.20)
set(project_dir "${CMAKE_CURRENT_LIST_DIR}")
file(READ "${project_dir}/VERSION.txt" version)
string(STRIP "${version}" version)
if(NOT version MATCHES "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$")
    message(FATAL_ERROR "VERSION.txt must contain four decimal components, e.g. 2.2.0.0")
endif()
string(REPLACE "." ";" components "${version}")
foreach(component IN LISTS components)
    if(component GREATER 65535)
        message(FATAL_ERROR "Windows version components must fit uint16")
    endif()
endforeach()
string(REPLACE "." "," VERSION_NUMBERS "${version}")

file(MAKE_DIRECTORY "${GEN_DIR}")
file(READ "${SOURCE_DIR}/a/include/CrackV4.h" c_header)
file(READ "${SOURCE_DIR}/a/include/CrackV4.hpp" cpp_header)
string(REPLACE "#pragma once" "" c_header "${c_header}")
string(REPLACE "#include \"CrackV4.h\"" "${c_header}" merged_header "${cpp_header}")
string(REGEX MATCHALL "CrackV4[A-Za-z0-9_]+" shared_api_names "${merged_header}")
list(REMOVE_DUPLICATES shared_api_names)
string(REPLACE "CrackV4Detector" "GrayDetectionV2" public_header "${merged_header}")
string(REPLACE "CrackV4" "GrayDetectionV2" public_header "${public_header}")
string(REPLACE "CRACK_V4_EXPORTS" "GRAYDETECTIONV2_EXPORTS" public_header "${public_header}")
string(REPLACE "CV4_" "GRAYDETECTIONV2_" public_header "${public_header}")
file(CONFIGURE OUTPUT "${GEN_DIR}/GrayDetectionV2.hpp" CONTENT "${public_header}" @ONLY)
file(READ "${SOURCE_DIR}/v512/exports.def" exports)
string(REPLACE "CrackV4" "GrayDetectionV2" exports "${exports}")
file(CONFIGURE OUTPUT "${GEN_DIR}/GrayDetectionV2.def" CONTENT "${exports}" @ONLY)

set(private_header "#pragma once\n#define GRAYDETECTION_FILE_VERSION \"${version}\"\n")
foreach(name IN LISTS shared_api_names)
    if(name STREQUAL "CrackV4Detector")
        set(public_name "GrayDetectionV2")
    else()
        string(REPLACE "CrackV4" "GrayDetectionV2" public_name "${name}")
    endif()
    string(APPEND private_header "#define ${name} ${public_name}\n")
endforeach()
file(CONFIGURE OUTPUT "${GEN_DIR}/GrayDetectionV2_build.h" CONTENT "${private_header}" @ONLY)
configure_file("${project_dir}/GrayDetectionV2.rc.in" "${GEN_DIR}/GrayDetectionV2.rc" @ONLY)
